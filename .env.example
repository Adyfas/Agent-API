BOT_TOKEN=znkdj
CHAT_ID_DEFAULT=123456789
API_SECRET=agentadyfas
# Kunci dari openrouter.ai (format sk-or-...). Websearch ter-billing per search call dari kredit OpenRouter.
OPENROUTER_API_KEY=sk-or-...
AI_MODEL=openai/gpt-4o-mini
# Daftar model untuk /model list & /model set (comma-separated). Kosong = pakai daftar default (6 model free).
# User bebas edit list ini (tambah/kurang model), pastikan model support tool calling.
AI_AVAILABLE_MODELS=apodex/apodex-1.1-mini:free,qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,inclusionai/ling-3.0-flash-sante:free
# Batas request AI per hari (untuk tampilan sisa kuota di /ask). Default 50 (free tier OpenRouter).
AI_DAILY_LIMIT=50
# /status tidak butuh env var baru: memakai OPENROUTER_API_KEY (+ OPENROUTER_API_BASE opsional) yang sudah ada.
AI_SYSTEM_PROMPT="Kamu adalah asisten AI di Telegram. Jawab singkat, jelas, dan to the point dalam bahasa Indonesia. Gunakan plain text tanpa markdown. PENTING: Jika pertanyaan membutuhkan informasi terkini (berita, perkembangan terbaru, fakta saat ini, versi, harga, dll), kamu WAJIB memanggil tool web_search dulu, lalu menjawab berdasarkan hasil search dan mencantumkan sumber URL-nya. Jangan menjawab topik terkini dari pengetahuan lama."
# --- Hook test (opsional, jangan di-set di produksi) ---
# TELEGRAM_API_BASE=http://127.0.0.1:3999   # arahkan Bot API ke mock (test suite lokal)
# OPENROUTER_API_BASE=http://127.0.0.1:3998 # arahkan OpenRouter ke mock (test suite lokal)
